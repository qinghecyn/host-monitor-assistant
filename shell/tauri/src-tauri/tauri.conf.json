{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "主机监控小助手",
  "version": "1.4.0",
  "identifier": "com.xiaozhushou.monitor",
  "build": {
    "frontendDist": "../../../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/web/": "web/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "实时查看 Linux 主机运行状态",
    "longDescription": "通过 SSH 只读采集 CPU / 内存 / 温度 / 磁盘 / 网络与 Docker 容器负载，支持多台目标主机，自带运行环境，装完即用。"
  }
}
